# SpatialTrace v2 Environment Configuration
# Mode: 'mock' (offline fixtures, no API keys needed) or 'live' (hackathon/Meta APIs)
SPATIALTRACE_MODE=mock
OFFLINE_SNAPSHOTS=0

# Model API credentials and endpoints
MODEL_API_KEY="YOUR_HACKATHON_API_KEY"
SAM_BASE_URL="https://api.meta.ai/v1"
SAM_MODEL_NAME="sam-3.1"
VLM_MODEL_NAME="cheap-vlm"
LLM_MODEL_NAME="muse-spark"

# Settle detector thresholds
SETTLE_SPIKE_THRESHOLD=500000
SETTLE_CALM_THRESHOLD=100000
SETTLE_CALM_FRAMES=6
MIN_DIFF_AREA=500

# SAM confidence bands
SAM_SCORE_HIGH=0.80
SAM_SCORE_MID=0.40

# Query candidates
RECALL_FRAME_COUNT=8
PARALLEL_CANDIDATE_COUNT=5
