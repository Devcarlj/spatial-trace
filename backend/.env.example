# SpatialTrace v2 Environment Configuration
# Mode: 'mock' (offline fixtures, no API keys needed) or 'live' (hackathon/Meta APIs)
SPATIALTRACE_MODE=mock
OFFLINE_SNAPSHOTS=0

# Model API credentials and endpoints
MODEL_API_KEY="YOUR_HACKATHON_API_KEY"
SAM_BASE_URL="https://api.meta.ai/v1"
SAM_MODEL_NAME="sam-3.1"
VLM_MODEL_NAME="muse-spark-1.3"
LLM_MODEL_NAME="muse-spark-1.3"

# Settle detector thresholds
SETTLE_SPIKE_THRESHOLD=500000
SETTLE_CALM_THRESHOLD=100000
SETTLE_CALM_FRAMES=6
MIN_DIFF_AREA=500

# Temporal coverage: periodic full frames plus scene-change observations
PERIODIC_KEYFRAME_INTERVAL_SECONDS=2
SCENE_CHANGE_THRESHOLD=2000000
SCENE_CHANGE_MIN_INTERVAL_SECONDS=1

# SAM confidence bands
SAM_SCORE_HIGH=0.80
SAM_SCORE_MID=0.40

# Query candidates
RECALL_FRAME_COUNT=8
PARALLEL_CANDIDATE_COUNT=5

# Milestone 2: per-query frame-check budget (stored sightings and cached
# provider calls are reused for free and do not consume it), finer checks
# allowed between the last positive sample and the next negative one, and
# the global-translation size that counts as a camera pan rather than a
# scene change on the 640x360 comparison frames.
QUERY_MAX_FRAME_CHECKS=32
QUERY_REFINEMENT_MAX_CHECKS=4
SCENE_PAN_MIN_SHIFT_PIXELS=10
SCENE_PAN_MIN_RESPONSE=0.25

# Extra SAM calls per candidate (0 disables recovery, maximum 8)
RECOVERY_MAX_CALLS=4
RECOVERY_TINY_SIDE=32

# Sparse sighting association and camera-compensated movement tolerance
MOVEMENT_MIN_PIXELS=12
MOVEMENT_RELATIVE_THRESHOLD=0.15
TRACKING_MAX_GAP_SECONDS=30
